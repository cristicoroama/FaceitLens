{
  "functions": {
    "api/render.js": {
      "includeFiles": "dist/spa.html",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/:dir(stickers|teams|flags|maps|map-icons|ranks|badges|weapons|games|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:file(og\\.png|hero\\.webp|hero-sm\\.webp|logo\\.png|logo512\\.png|icon-192\\.png|favicon\\.png|favicon32\\.png|apple-touch-icon\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/og/:nick",
      "destination": "/api/og?nick=:nick"
    },
    {
      "source": "/sitemap-players.xml",
      "destination": "/api/sitemap-players"
    },
    {
      "source": "/sitemap-players-:page(\\d+)\\.xml",
      "destination": "/api/sitemap-players?page=:page"
    },
    {
      "source": "/p/:nick",
      "destination": "/api/share?nick=:nick"
    },
    {
      "source": "/:lang(ru|pl|uk)/player/:nick",
      "has": [
        {
          "type": "query",
          "key": "__spa",
          "value": "1"
        }
      ],
      "destination": "/spa.html"
    },
    {
      "source": "/player/:nick",
      "has": [
        {
          "type": "query",
          "key": "__spa",
          "value": "1"
        }
      ],
      "destination": "/spa.html"
    },
    {
      "source": "/:lang(ru|pl|uk)/player/:nick",
      "destination": "/api/render?nick=:nick&lang=:lang"
    },
    {
      "source": "/player/:nick",
      "destination": "/api/render?nick=:nick"
    },
    {
      "source": "/overlay/:token",
      "destination": "/spa.html"
    },
    {
      "source": "/((?:(?:ru|pl|uk)/)?(?:steam|u|leaderboard)/[^/]+/?)",
      "destination": "/spa.html"
    },
    {
      "source": "/((?:(?:ru|pl|uk)/)?[^/.]+/?)",
      "destination": "/spa.html"
    }
  ]
}
